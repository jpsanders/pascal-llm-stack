diff -ruN nvidia-pristine/kernel/nvidia/nv-mmap.c nvidia-570.211.01/kernel/nvidia/nv-mmap.c
--- nvidia-pristine/kernel/nvidia/nv-mmap.c	2025-11-25 16:51:27.000000000 +0000
+++ nvidia-570.211.01/kernel/nvidia/nv-mmap.c	2026-10-16 19:27:33.175151898 +0000
@@ -869,6 +869,71 @@
 }
 
 #if !NV_CAN_CALL_VMA_START_WRITE
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION(7, 0, 0))
+/*
+ * Linux 7.0 reworked the per-VMA locking scheme (the 6.x VMA_LOCK_OFFSET
+ * protocol is gone).  __vma_start_write() remains GPL-only, so as on 6.x we
+ * roll our own vma write lock.  The 7.0 protocol, as documented in
+ * include/linux/mm_types.h (vm_refcnt) and include/linux/mmap_lock.h:
+ *
+ *  1. A writer sets VM_REFCNT_EXCLUDE_READERS_FLAG in vma->vm_refcnt,
+ *     which makes vma_start_read() refuse to take new read locks.
+ *  2. The writer waits until all readers have dropped their references
+ *     (refcount == VM_REFCNT_EXCLUDE_READERS_FLAG + 1), waiting on the
+ *     mm's vma_writer_wait rcuwait; readers wake the writer when done.
+ *  3. While readers are excluded, vm_flags / vm_lock_seq may be written;
+ *     the VMA is marked write-locked by setting vma->vm_lock_seq to the
+ *     current mm lock sequence (__vma_raw_mm_seqnum()).
+ *  4. __vma_end_exclude_readers() clears the flag again.
+ *
+ * A detached (refcount zero) VMA is not reachable by readers and may be
+ * marked write-locked directly.  This mirrors what the kernel's own
+ * vma_start_write() does, using only non-GPL inline helpers; the lockdep
+ * annotations of the kernel implementation are intentionally omitted.
+ * The caller must hold mmap_lock in write mode (true in the driver's
+ * .mmap call sites).
+ */
+void nv_vma_start_write(struct vm_area_struct *vma)
+{
+    unsigned int mm_lock_seq;
+
+    if (__is_vma_write_locked(vma))
+        return;
+
+    mm_lock_seq = __vma_raw_mm_seqnum(vma);
+
+    if (refcount_add_not_zero(VM_REFCNT_EXCLUDE_READERS_FLAG, &vma->vm_refcnt))
+    {
+        /* Attached VMA: exclude new readers, wait for existing ones. */
+        prepare_to_rcuwait(&vma->vm_mm->vma_writer_wait);
+
+        for (;;)
+        {
+            set_current_state(TASK_UNINTERRUPTIBLE);
+            if (refcount_read(&vma->vm_refcnt) ==
+                    (VM_REFCNT_EXCLUDE_READERS_FLAG + 1))
+                break;
+            schedule();
+        }
+
+        /* Open-coded finish_rcuwait() (not exported to modules). */
+        rcu_assign_pointer(vma->vm_mm->vma_writer_wait.task, NULL);
+        __set_current_state(TASK_RUNNING);
+
+        WRITE_ONCE(vma->vm_lock_seq, mm_lock_seq);
+
+        /* End the readers-exclusion phase; back to plain "attached". */
+        WARN_ON_ONCE(refcount_sub_and_test(VM_REFCNT_EXCLUDE_READERS_FLAG,
+                                            &vma->vm_refcnt));
+    }
+    else
+    {
+        /* Detached (unpublished) VMA: exclusively owned by the caller. */
+        WRITE_ONCE(vma->vm_lock_seq, mm_lock_seq);
+    }
+}
+EXPORT_SYMBOL(nv_vma_start_write);
+#else /* LINUX_VERSION_CODE < KERNEL_VERSION(7, 0, 0) */
 static NvBool nv_vma_enter_locked(struct vm_area_struct *vma, NvBool detaching)
 {
     NvU32 tgt_refcnt = VMA_LOCK_OFFSET;
@@ -938,4 +1003,5 @@
     }
 }
 EXPORT_SYMBOL(nv_vma_start_write);
+#endif /* LINUX_VERSION_CODE < KERNEL_VERSION(7, 0, 0) */
 #endif // !NV_CAN_CALL_VMA_START_WRITE
