diff -ruN nvidia-pristine/kernel/common/inc/nv-mm.h nvidia-570.211.01/kernel/common/inc/nv-mm.h
--- nvidia-pristine/kernel/common/inc/nv-mm.h	2025-11-25 16:51:10.000000000 +0000
+++ nvidia-570.211.01/kernel/common/inc/nv-mm.h	2026-10-16 19:12:16.483683001 +0000
@@ -303,6 +303,25 @@
 #define NV_CAN_CALL_VMA_START_WRITE 1
 #endif
 
+/*
+ * Linux 7.0 reworked the VMA locking and flag scheme:
+ *
+ *  - The private "__vm_flags" member is gone: vm_flags is now a const union
+ *    member backed by a bitmap ("vma_flags_t flags"), with the kernel
+ *    providing static inline first-word helpers (vma_flags_set_word() /
+ *    vma_flags_clear_word() in linux/mm_types.h).
+ *  - vma_start_write() is still a static inline in linux/mmap_lock.h, but it
+ *    now calls the GPL-only out-of-line __vma_start_write(), so
+ *    NV_CAN_CALL_VMA_START_WRITE remains 0 and the driver keeps its own
+ *    open-coded vma write lock: nv_vma_start_write() in nvidia/nv-mmap.c is
+ *    implemented separately for the 7.0 VMA refcount scheme
+ *    (VM_REFCNT_EXCLUDE_READERS_FLAG, documented in linux/mm_types.h).
+ *
+ * linux/version.h must be included directly here because this header is
+ * processed before nv-linux.h's own version.h include.
+ */
+#include <linux/version.h>
+
 #if !NV_CAN_CALL_VMA_START_WRITE
 /*
  * Commit 45ad9f5290dc updated vma_start_write() to call __vma_start_write().
@@ -314,7 +333,11 @@
 {
 #if !NV_CAN_CALL_VMA_START_WRITE
     nv_vma_start_write(vma);
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION(7, 0, 0))
+    vma_flags_set_word(&vma->flags, flags);
+#else
     ACCESS_PRIVATE(vma, __vm_flags) |= flags;
+#endif
 #elif defined(NV_VM_AREA_STRUCT_HAS_CONST_VM_FLAGS)
     vm_flags_set(vma, flags);
 #else
@@ -326,7 +349,11 @@
 {
 #if !NV_CAN_CALL_VMA_START_WRITE
     nv_vma_start_write(vma);
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION(7, 0, 0))
+    vma_flags_clear_word(&vma->flags, flags);
+#else
     ACCESS_PRIVATE(vma, __vm_flags) &= ~flags;
+#endif
 #elif defined(NV_VM_AREA_STRUCT_HAS_CONST_VM_FLAGS)
     vm_flags_clear(vma, flags);
 #else
